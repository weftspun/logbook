#usda 1.0
(
    defaultPrim = "FourLoops"
    metersPerUnit = 1
    upAxis = "Z"
    customLayerData = {
        string plan = "fourloops"
        string state = "build"
        string[] sources = [
            "7-service/service-livebook/priv/python/weft_loop.py",
            "6-datasource/anny-render-corpus/score_edits.py",
            "6-datasource/anny-render-corpus/gen_posed_from_reference.py",
            "6-datasource/anny-render-corpus/render_view.py",
            "3-interactor/pose-consensus/python/soma_referee.py",
            "1-transport/rf-detr-mcp/server.py",
            "3-interactor/voxhammer-image-mesh-editing/server.py",
            "3-interactor/pixal3d-image-to-textured-mesh/server.py",
            "CLAUDE.md",
            "2-contract/logbook/logbook-fourloops-first-runs.md",
        ]
        string[] stateVocabulary = ["exists", "build", "measure", "stub", "blocked"]
        string[] sizeVocabulary = ["XS", "S", "M", "L", "XL"]
        int[] sizePoints = [1, 2, 3, 5, 8]
    }
)

def Scope "FourLoops"
{
    def Scope "Quantities"
    {
        custom int cocoKeypoints = 17
        custom int annyKeypointAssetPoints = 23
        custom int basemeshVertices = 19158
        custom int hammersleyViews = 8
        custom float editscorePeakGib512 = 6.75
        custom float editscorePeakGib1024 = 8.6
        custom int editscoreMaxPixels = 262144
        custom int omnigen2WeightsGib = 17
        custom int deskVramGib = 24
        custom int voxhammerPlanSteps = 7
        custom float refereeImpossibleResidual = 0.02
        custom float refereeHandResidual = 0.006
        custom float refereeChainGrowthLimit = 1.6
        custom float editscoreScaleMax = 10
        custom float editscoreMatchingOverall = 4.29
        custom float editscoreNonsenseOverall = 0.0
        custom float omnigen2WeightsGibBf16 = 14.75
        custom float omnigen2PeakGibBf16 = 17.14
        custom float omnigen2WeightsGibNf4 = 4.33
        custom float omnigen2PeakGibNf4 = 6.72
        custom int ugen300BudgetGb = 8
    }

    def Scope "Stages"
    {
        def "Keypoints"
        {
            custom uniform token kind = "detector"
            custom uniform token state = "blocked"
            custom uniform token blocker = "environment"
            custom string[] blockedOn = ["rfdetr"]
            custom string entry = "1-transport/rf-detr-mcp/server.py:analyze_pose"
            custom string outputs = "17 joints, pixels and confidence"
        }

        def "AnnyFit"
        {
            custom uniform token kind = "fit"
            custom uniform token state = "exists"
            custom string entry = "7-service/service-livebook/priv/python/loop1_fit.py:fit_2d"
            custom string outputs = "pose, keypoints2d, residual_px, stature_px, camera"
            custom float roundTripMedianPx = 1.56
            custom float roundTripPctOfStature = 0.263
            custom bool retracted = 1
            custom uniform token retractedState = "blocked"
            custom string[] vertexOnlySolvers = ["anny.AnnyInverter", "soma.PoseInversion"]
        }

        def "Render"
        {
            custom uniform token kind = "render"
            custom uniform token state = "exists"
            custom string entry = "6-datasource/anny-render-corpus/render_view.py"
            custom string outputs = "png and json sidecar"
        }

        def "EditScore"
        {
            custom uniform token kind = "scorer"
            custom uniform token state = "exists"
            custom string entry = "editscore.EditScore.evaluate"
            custom string base = "Qwen/Qwen3-VL-8B-Instruct"
            custom string adapter = "EditScore/EditScore-Qwen3-VL-8B-Instruct"
            custom string precision = "nf4"
            custom string precisionNote = "Quantisation is permitted for a verifier and forbidden for a generator. This is a verifier."
        }

        def "OmniGen2"
        {
            custom uniform token kind = "generator"
            custom uniform token state = "exists"
            custom string entry = "6-datasource/anny-render-corpus/omnigen2_edit.py"
            custom string environment = "pixi -e omnigen2"
        }

        def "CycleGan"
        {
            custom uniform token kind = "generator"
            custom uniform token state = "exists"
            custom string entry = "3-interactor/cyclegan-style-transfer/server.py:/predict"
        }

        def "Pixal3D"
        {
            custom uniform token kind = "generator"
            custom uniform token state = "exists"
            custom string entry = "3-interactor/pixal3d-image-to-textured-mesh/server.py"
            custom string outputs = "state, views, cameras, then glb and layer"
        }

        def "VoxHammer"
        {
            custom uniform token kind = "editor"
            custom uniform token state = "stub"
            custom bool wired = 0
            custom string[] blockedOn = ["not-implemented", "takes-mesh-not-latent", "usd-layer-not-renderable"]
            custom string entry = "3-interactor/voxhammer-image-mesh-editing/server.py:/predict"
            custom string inputs = "mesh, reference, region, seed"
        }

        def "Referee"
        {
            custom uniform token kind = "gate"
            custom uniform token state = "exists"
            custom string entry = "3-interactor/pose-consensus/python/soma_referee.py:referee"
            custom string[] verdicts = ["FITS", "IMPOSSIBLE", "HANDS_UNTRUSTED", "NOT_RUN"]
        }

        def "Harness"
        {
            custom uniform token kind = "harness"
            custom uniform token state = "measure"
            custom string entry = "7-service/service-livebook/priv/python/weft_loop.py"
            custom string controls = "7-service/service-livebook/priv/python/test_weft_loop.py"
        }
    }

    def Scope "Loops"
    {
        def "L1KeypointsToAnny"
        {
            custom int order = 1
            custom uniform token size = "L"
            custom uniform token state = "build"
            custom string artifact = "render png"
            rel driver = </FourLoops/Stages/Harness>
            rel propose = [
                </FourLoops/Stages/Keypoints>,
                </FourLoops/Stages/AnnyFit>,
                </FourLoops/Stages/Render>,
            ]
            rel score = [
                </FourLoops/Stages/EditScore>,
                </FourLoops/Stages/Referee>,
            ]
            rel repair = </FourLoops/Stages/AnnyFit>
            custom string hazard = "The detector emits 17 joints and the render asset emits 23. The comparison takes an explicit subset or it compares different things."
        }

        def "L2ImageToOmniGen2"
        {
            custom int order = 2
            custom uniform token size = "M"
            custom uniform token state = "build"
            custom string artifact = "edited png"
            rel driver = </FourLoops/Stages/Harness>
            rel propose = </FourLoops/Stages/OmniGen2>
            rel score = </FourLoops/Stages/EditScore>
            rel repair = </FourLoops/Stages/OmniGen2>
            custom string hazard = "The instruction comes from a text input rather than a filename, because a filename that matches no key is skipped without a word."
        }

        def "L3StylizedToOmniGen2"
        {
            custom int order = 3
            custom uniform token size = "M"
            custom uniform token state = "build"
            custom string artifact = "edited png"
            rel driver = </FourLoops/Stages/Harness>
            rel propose = [
                </FourLoops/Stages/CycleGan>,
                </FourLoops/Stages/OmniGen2>,
            ]
            rel score = </FourLoops/Stages/EditScore>
            rel repair = </FourLoops/Stages/OmniGen2>
            custom string hazard = "Anything derived from val2017 inherits the holdout. A stylized set built from it is evaluation only, twice over."
        }

        def "L4LatentToPixal3D"
        {
            custom int order = 4
            custom uniform token size = "XL"
            custom uniform token state = "build"
            custom string artifact = "latent state, then views, then glb"
            rel driver = </FourLoops/Stages/Harness>
            rel propose = </FourLoops/Stages/Pixal3D>
            rel score = </FourLoops/Stages/EditScore>
            rel repair = [
                </FourLoops/Stages/VoxHammer>,
                </FourLoops/Stages/OmniGen2>,
            ]
            custom uniform token routerStatistic = "spread-over-mean"
            custom float spreadSelectsLatent = 0.15
            custom bool routerCalibrated = 0
            custom string hazard = "VoxHammer raises NotImplementedError outside stub mode, and it takes a mesh rather than the latent, so the arm passes through /extract first."
        }
    }

    def Scope "Tasks"
    {
        def "T01Harness"
        {
            custom int order = 1
            custom uniform token size = "M"
            custom uniform token state = "exists"
            rel produces = </FourLoops/Stages/Harness>
        }

        def "T02Notebook2"
        {
            custom int order = 2
            custom uniform token size = "M"
            custom uniform token state = "build"
            rel needs = </FourLoops/Tasks/T01Harness>
            rel realizes = </FourLoops/Loops/L2ImageToOmniGen2>
        }

        def "T03Notebook3"
        {
            custom int order = 3
            custom uniform token size = "S"
            custom uniform token state = "build"
            rel needs = </FourLoops/Tasks/T02Notebook2>
            rel realizes = </FourLoops/Loops/L3StylizedToOmniGen2>
        }

        def "T04Notebook1"
        {
            custom int order = 4
            custom uniform token size = "L"
            custom uniform token state = "build"
            rel needs = </FourLoops/Tasks/T01Harness>
            rel realizes = </FourLoops/Loops/L1KeypointsToAnny>
        }

        def "T05Notebook4"
        {
            custom int order = 5
            custom uniform token size = "L"
            custom uniform token state = "build"
            rel needs = </FourLoops/Tasks/T01Harness>
            rel realizes = </FourLoops/Loops/L4LatentToPixal3D>
        }

        def "T06Serve"
        {
            custom int order = 6
            custom uniform token size = "XS"
            custom uniform token state = "build"
            rel needs = </FourLoops/Tasks/T01Harness>
        }

        def "T07WireVoxHammer"
        {
            custom int order = 7
            custom uniform token size = "XL"
            custom uniform token state = "blocked"
            rel needs = </FourLoops/Tasks/T05Notebook4>
            rel produces = </FourLoops/Stages/VoxHammer>
        }
    }
}
